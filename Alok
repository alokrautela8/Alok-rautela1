#include <iostream>
#include <cstring>
#include <cstdlib>
#include <ctime>

using namespace std;

struct WordData
{
    char word[20];
    char question[100];
};

int main()
{
    char playerName[50];
    int age;

    cout << "===================================" << endl;
    cout << "     WORD GUESSING GAME" << endl;
    cout << "===================================" << endl;

    cout << "Enter Player Name: ";
    cin.getline(playerName, 50);

    cout << "Enter Your Age: ";
    cin >> age;

    WordData words[] =
    {
        {"APPLE", "I am a fruit, red or green, and keep the doctor away. What am I?"},
        {"OCEAN", "I am a vast body of saltwater. What am I?"},
        {"COMPUTER", "I am an electronic device used for programming and gaming. What am I?"},
        {"PIANO", "I am a musical instrument with black and white keys. What am I?"},
        {"SUN", "I give light and heat to the Earth. What am I?"}
    };

    int numWords = sizeof(words) / sizeof(words[0]);

    srand(time(0));

    char playAgain = 'Y';

    cout << "\nWelcome " << playerName << "!" << endl;
    cout << "You have total 5 attempts for each question.\n" << endl;

    while(playAgain == 'Y' || playAgain == 'y')
    {
        int randomIndex = rand() % numWords;

        char secretWord[20];
        char question[100];
        char guess[20];

        strcpy(secretWord, words[randomIndex].word);
        strcpy(question, words[randomIndex].question);

        int attempts = 0;
        int maxAttempts = 5;

        bool correct = false;

        cout << "-----------------------------------" << endl;
        cout << "Question: " << question << endl;

        while(attempts < maxAttempts)
        {
            cout << "\nEnter your answer: ";
            cin >> guess;

            for(int i = 0; guess[i]; i++)
            {
                if(guess[i] >= 'a' && guess[i] <= 'z')
                {
                    guess[i] = guess[i] - 32;
                }
            }

            if(strcmp(guess, secretWord) == 0)
            {
                cout << "\nCorrect Answer!" << endl;
                cout << "You guessed the word: " << secretWord << endl;

                correct = true;

                char nextChoice;

                cout << "\nDo you want to play next question? (Y/N): ";
                cin >> nextChoice;

                if(nextChoice == 'Y' || nextChoice == 'y')
                {
                    break;
                }
                else
                {
                    cout << "\nThank You For Playing!" << endl;
                    return 0;
                }
            }
            else
            {
                attempts++;

                cout << "\nWrong Answer!" << endl;
                cout << "Remaining Attempts: "
                     << (maxAttempts - attempts) << endl;
            }
        }

        if(!correct)
        {
            cout << "\nYou Lost All Attempts!" << endl;
            cout << "Correct Answer Was: " << secretWord << endl;

            cout << "\nDo you want to play again? (Y/N): ";
            cin >> playAgain;
        }
    }

    cout << "\nGame Ended!" << endl;

    return 0;
}
